# Firebase web app config for the marlowe-and-vane project. Copy this file to .env and fill in the values from
# Firebase console > Project settings > General > Your apps > SDK setup and configuration (Config).
# .env is git-ignored. `npm run config`, `npm run dev`, and every deploy turn it into public/js/firebase-config.js.
# MV_ stands for Marlowe & Vane; the prefix keeps these apart from other Firebase variables in your shell.
MV_FIREBASE_API_KEY=
MV_FIREBASE_AUTH_DOMAIN=
MV_FIREBASE_PROJECT_ID=
MV_FIREBASE_STORAGE_BUCKET=
MV_FIREBASE_MESSAGING_SENDER_ID=
MV_FIREBASE_APP_ID=
